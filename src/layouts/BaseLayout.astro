---
import revealScript from "../scripts/reveal.js?url";
import formsScript from "../scripts/forms.js?url";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = "Kitstation | Agencia de Marketing Digital y Desarrollo Web en Perú",
  description = "Creamos páginas web, campañas en Google Ads y Meta Ads, automatizaciones de WhatsApp y sistemas CRM para empresas en Perú.",
  image = "/images/og-kitstation.jpg",
  imageAlt = "Portada de Kitstation con servicios de marketing digital y desarrollo web",
  ogType = "website",
  robots = "index,follow",
  structuredData
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
const structuredDataItems = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<!doctype html>
<html lang="es" data-turnstile-site-key={turnstileSiteKey}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0553f1" />
    <meta name="google-site-verification" content="xeoFs1ZhNRa4nn1mcQpHi8mVVmIZWp_EAMnE0D3h134" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer></script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="KitStation" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    {structuredDataItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <slot />
    <section class="cookie-banner" data-cookie-banner aria-label="Aviso de cookies" hidden>
      <p>
        ¡Bienvenido a kitstation.pe! Para proporcionarte una mejor experiencia, utilizamos cookies para habilitar algunas funciones del sitio web. Las cookies nos ayudan a ver qué artículos pueden ser de mayor interés para usted; le permiten compartir fácilmente artículos en las redes sociales; nos permiten entregar contenido, trabajos y anuncios adaptados a sus intereses y ubicaciones; y proporcionar muchos otros beneficios del sitio. Para obtener más información, consulte nuestra <a href="/politicas-y-privacidad/">Política de Cookies y Política de Privacidad</a>.
      </p>
      <div class="cookie-banner__actions">
        <button class="cookie-banner__link" type="button" data-cookie-config>Configuración de cookies</button>
        <button class="cookie-banner__button" type="button" data-cookie-choice="rejected">Rechazarlas todas</button>
        <button class="cookie-banner__button" type="button" data-cookie-choice="accepted">Aceptar todas las cookies</button>
      </div>
    </section>
    <script type="module" define:vars={{ revealScript }}>
      const loadReveal = () => {
        import(revealScript);
      };

      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(loadReveal, { timeout: 1200 });
      } else {
        window.addEventListener("load", () => {
          window.setTimeout(loadReveal, 120);
        }, { once: true });
      }
    </script>
    <script>
      (() => {
        const banner = document.querySelector("[data-cookie-banner]");
        if (!banner) return;

        const storageKey = "kitstation-cookie-consent";
        const storedChoice = window.localStorage.getItem(storageKey);
        if (storedChoice) return;

        banner.hidden = false;

        banner.querySelectorAll("[data-cookie-choice]").forEach((button) => {
          button.addEventListener("click", () => {
            window.localStorage.setItem(storageKey, button.dataset.cookieChoice || "configured");
            banner.hidden = true;
          });
        });

        banner.querySelector("[data-cookie-config]")?.addEventListener("click", () => {
          window.localStorage.setItem(storageKey, "configured");
          banner.hidden = true;
        });
      })();
    </script>
    <script type="module" src={formsScript}></script>
  </body>
</html>
