---
import revealScript from "../scripts/reveal.js?url";
import formsScript from "../scripts/forms.js?url";
import GoogleTag from "../components/GoogleTag.astro";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  ogType?: string;
  robots?: string;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
}

const {
  title = "Kitstation | Agencia de Marketing Digital y Desarrollo Web en Perú",
  description = "Creamos páginas web, campañas en Google Ads y Meta Ads, automatizaciones de WhatsApp y sistemas CRM para empresas en Perú.",
  image = "/images/og-kitstation.jpg",
  imageAlt = "Portada de Kitstation con servicios de marketing digital y desarrollo web",
  ogType = "website",
  robots = "index,follow",
  structuredData
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
const structuredDataItems = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<!doctype html>
<html lang="es" data-turnstile-site-key={turnstileSiteKey}>
  <head>
    <meta charset="UTF-8" />
    <GoogleTag />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0553f1" />
    <meta name="google-site-verification" content="xeoFs1ZhNRa4nn1mcQpHi8mVVmIZWp_EAMnE0D3h134" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/poppins-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-600.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preconnect" href="https://challenges.cloudflare.com" />
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit" defer></script>

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="KitStation" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    {structuredDataItems.map((item) => (
      <script type="application/ld+json" set:html={JSON.stringify(item)} />
    ))}
  </head>
  <body>
    <slot />
    <CookieBanner />
    <script type="module" define:vars={{ revealScript }}>
      const loadReveal = () => {
        import(revealScript);
      };

      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(loadReveal, { timeout: 1200 });
      } else {
        window.addEventListener("load", () => {
          window.setTimeout(loadReveal, 120);
        }, { once: true });
      }
    </script>
    <script type="module" src={formsScript}></script>
  </body>
</html>
