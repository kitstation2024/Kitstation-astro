---
// src/components/FooterKit.astro
---

<footer class="footer-kit bg-black text-white pt-24 pb-8 border-t border-white/5 font-sans relative isolate overflow-hidden">
  <div class="footer-kit__glow footer-kit__glow--blue" aria-hidden="true"></div>
  <div class="footer-kit__glow footer-kit__glow--white" aria-hidden="true"></div>

  <div class="max-w-7xl mx-auto px-6 md:px-12 relative z-10">
    
    <!-- Top Section: Links and Newsletter -->
    <div class="flex flex-col lg:flex-row justify-between gap-16 lg:gap-8 mb-24">
      
      <!-- Link Columns (Left) -->
      <div class="hidden lg:grid grid-cols-3 gap-12 lg:w-3/5">
        
        <!-- Column 1: Empresa -->
        <div class="flex flex-col gap-6">
          <h4 class="text-white font-medium text-[15px]">Empresa</h4>
          <ul class="flex flex-col gap-4">
            <li><a href="/" class="text-[#aaa] hover:text-white text-[15px] transition-colors">Inicio</a></li>
            <li><a href="/proyectos" class="text-[#aaa] hover:text-white text-[15px] transition-colors">Proyectos</a></li>
            <li><a href="/sobre-kit" class="text-[#aaa] hover:text-white text-[15px] transition-colors">Sobre Kit</a></li>
            <li><a href="/contacto" class="text-[#aaa] hover:text-white text-[15px] transition-colors">Contacto</a></li>
          </ul>
        </div>

        <!-- Column 2: Servicios -->
        <div class="flex flex-col gap-6">
          <h4 class="text-white font-medium text-[15px]">Servicios</h4>
          <ul class="flex flex-col gap-4">
            <li><a href="/diseno-desarrollo-web" class="text-[#aaa] hover:text-white text-[15px] transition-colors">Diseño web</a></li>
            <li><a href="/automatizaciones-con-ia" class="text-[#aaa] hover:text-white text-[15px] transition-colors">Automatizaciones con IA</a></li>
            <li><a href="/desarrollo-de-software" class="text-[#aaa] hover:text-white text-[15px] transition-colors">Desarrollo de software</a></li>
            <li><a href="/identidad-de-marca-y-contenido-audiovisual" class="text-[#aaa] hover:text-white text-[15px] transition-colors">Identidad de marca</a></li>
          </ul>
        </div>

        <!-- Column 3: Descubre -->
        <div class="flex flex-col gap-6">
          <h4 class="text-white font-medium text-[15px]">Descubre</h4>
          <ul class="flex flex-col gap-4">
            <li><a href="/terminos-y-condiciones" class="text-[#aaa] hover:text-white text-[15px] transition-colors">Términos y condiciones</a></li>
            <li><a href="/politicas-de-privacidad" class="text-[#aaa] hover:text-white text-[15px] transition-colors">Políticas de privacidad</a></li>
            <li><a href="/faqs" class="text-[#aaa] hover:text-white text-[15px] transition-colors">FAQs</a></li>
          </ul>
        </div>

      </div>

      <!-- Mobile accordion navigation -->
      <div class="lg:hidden w-full border-t border-white/10">
        <details class="group border-b border-white/10">
          <summary class="flex items-center justify-between py-5 text-white font-medium text-[17px] cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            Empresa
          </summary>
          <ul class="pb-5 flex flex-col gap-3">
            <li><a href="/" class="text-[#aaa] hover:text-white text-[16px] transition-colors">Inicio</a></li>
            <li><a href="/proyectos" class="text-[#aaa] hover:text-white text-[16px] transition-colors">Proyectos</a></li>
            <li><a href="/sobre-kit" class="text-[#aaa] hover:text-white text-[16px] transition-colors">Sobre Kit</a></li>
            <li><a href="/contacto" class="text-[#aaa] hover:text-white text-[16px] transition-colors">Contacto</a></li>
          </ul>
        </details>

        <details class="group border-b border-white/10">
          <summary class="flex items-center justify-between py-5 text-white font-medium text-[17px] cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            Servicios
          </summary>
          <ul class="pb-5 flex flex-col gap-3">
            <li><a href="/diseno-desarrollo-web" class="text-[#aaa] hover:text-white text-[16px] transition-colors">Diseño web</a></li>
            <li><a href="/automatizaciones-con-ia" class="text-[#aaa] hover:text-white text-[16px] transition-colors">Automatizaciones con IA</a></li>
            <li><a href="/desarrollo-de-software" class="text-[#aaa] hover:text-white text-[16px] transition-colors">Desarrollo de software</a></li>
            <li><a href="/identidad-de-marca-y-contenido-audiovisual" class="text-[#aaa] hover:text-white text-[16px] transition-colors">Identidad de marca</a></li>
          </ul>
        </details>

        <details class="group border-b border-white/10">
          <summary class="flex items-center justify-between py-5 text-white font-medium text-[17px] cursor-pointer list-none [&::-webkit-details-marker]:hidden">
            Descubre
          </summary>
          <ul class="pb-5 flex flex-col gap-3">
            <li><a href="/terminos-y-condiciones" class="text-[#aaa] hover:text-white text-[16px] transition-colors">Términos y condiciones</a></li>
            <li><a href="/politicas-de-privacidad" class="text-[#aaa] hover:text-white text-[16px] transition-colors">Políticas de privacidad</a></li>
            <li><a href="/faqs" class="text-[#aaa] hover:text-white text-[16px] transition-colors">FAQs</a></li>
          </ul>
        </details>
      </div>

      <!-- Newsletter Column (Right) -->
      <div class="lg:w-[35%] flex flex-col">
        <p class="text-white text-[15px] leading-relaxed mb-8 font-medium">
          Déjanos tu email y nosotros nos pondremos en contacto dentro de 24H.
        </p>
        
        <form class="relative mb-2" action="/api/enviar-formulario" method="POST" data-mail-form data-turnstile-placement="after">
          <input type="hidden" name="formulario" value="Suscripción al newsletter" />
          <input type="hidden" name="pagina_origen" value="" />
          <input 
            type="email" 
            name="email"
            placeholder="Tu correo electrónico" 
            class="w-full bg-transparent border-b border-[#444] text-white text-lg py-3 focus:outline-none focus:border-white transition-colors placeholder-[#666]"
            required
          />
          <button type="submit" aria-label="Suscribirme al newsletter" class="absolute right-0 top-1/2 -translate-y-1/2 text-white hover:text-gray-300 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </form>
        <p class="form-feedback text-left" role="status" aria-live="polite"></p>

        <p class="text-[#aaa] text-[13px] leading-relaxed">
          Al suscribirte, aceptas nuestra <a href="/politicas-de-privacidad" class="underline hover:text-white">Política de Privacidad</a>. Tratamos tu información con responsabilidad. Cancela cuando quieras.
        </p>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="flex flex-col md:flex-row justify-between items-center gap-6 pt-6 border-t border-[#222]">
      
      <!-- Copyright -->
      <div class="text-[#aaa] text-[14px]">
        Copyright &copy; {new Date().getFullYear()} KitStation&reg; | Lima | Perú
      </div>

      <!-- Social Icons -->
      <div class="flex items-center gap-6 text-[#aaa]">
        <a href="https://www.linkedin.com/company/kitstation" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="LinkedIn">
          <i class="bi bi-linkedin text-[18px]"></i>
        </a>
        <a href="https://www.instagram.com/kitstationpe/reels/" target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors" aria-label="Instagram">
          <i class="bi bi-instagram text-[18px]"></i>
        </a>
      </div>

      <!-- Back to top -->
      <div>
        <button onclick="window.scrollTo({top: 0, behavior: 'smooth'})" class="text-[#aaa] hover:text-white text-[14px] transition-colors flex items-center gap-1">
          Volver arriba &uarr;
        </button>
      </div>

    </div>
    
  </div>
</footer>

<style>
  .footer-kit__glow {
    position: absolute;
    border-radius: 9999px;
    pointer-events: none;
    filter: blur(120px);
    opacity: 0.38;
    z-index: 0;
    will-change: transform;
    animation: footerGlowDrift 9s ease-in-out infinite alternate;
  }

  .footer-kit__glow--blue {
    width: 520px;
    height: 420px;
    left: 12%;
    bottom: -260px;
    background: #0066ff;
  }

  .footer-kit__glow--white {
    width: 620px;
    height: 520px;
    right: -140px;
    top: -80px;
    background: #ffffff;
    opacity: 0.14;
    animation-duration: 12s;
    animation-delay: -5s;
    animation-direction: alternate-reverse;
  }

  @keyframes footerGlowDrift {
    from { transform: translate3d(-18%, -8%, 0) scale(0.9); }
    to { transform: translate3d(22%, 14%, 0) scale(1.15); }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-kit__glow { animation: none; }
  }
</style>
