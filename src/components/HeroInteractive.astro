        <!-- Node 2 (Inner, 45° / Top-Right) -->
        <div class="absolute left-[65.9%] top-[34.1%]">
          <a href="/contacto" class="animate-counter-orbit absolute left-0 top-0 block group" title="Contáctanos">
            <div id="galaxy-node-2" class="liquid-node w-10 h-10 md:w-12 md:h-12 rounded-full flex items-center justify-center font-bold text-lg transition-all duration-500 group-hover:scale-[1.15] opacity-0 scale-50 overflow-hidden"><img src="/galaxy/icono-2.png" alt="Icono 2" class="w-full h-full object-cover" /></div>
          </a>
        </div>
        
        <!-- Node 3 (Middle, 90° / Right) -->
        <div class="absolute left-[85%] top-[50%]">
          <a href="/contacto" class="animate-counter-orbit absolute left-0 top-0 block group" title="Contáctanos">
            <div id="galaxy-node-3" class="liquid-node w-10 h-10 md:w-12 md:h-12 rounded-full flex items-center justify-center font-bold text-lg transition-all duration-500 group-hover:scale-[1.15] opacity-0 scale-50 overflow-hidden"><img src="/galaxy/icono-3.png" alt="Icono 3" class="w-full h-full object-cover" /></div>
          </a>
        </div>
        <!-- Node 4 (Outer, 135° / Bottom-Right) -->
        <div class="absolute left-[83.6%] top-[83.6%]">
          <a href="/contacto" class="animate-counter-orbit absolute left-0 top-0 block group" title="Contáctanos">
            <div id="galaxy-node-4" class="liquid-node w-10 h-10 md:w-12 md:h-12 rounded-full flex items-center justify-center font-bold text-lg transition-all duration-500 group-hover:scale-[1.15] opacity-0 scale-50 overflow-hidden"><img src="/galaxy/icono-4.png" alt="Icono 4" class="w-full h-full object-cover" /></div>
          </a>
        </div>
        <!-- Node 5 (Inner, 180° / Bottom) -->
        <div class="absolute left-[50%] top-[72.5%]">
          <a href="/contacto" class="animate-counter-orbit absolute left-0 top-0 block group" title="Contáctanos">
            <div id="galaxy-node-5" class="liquid-node w-10 h-10 md:w-12 md:h-12 rounded-full flex items-center justify-center font-bold text-lg transition-all duration-500 group-hover:scale-[1.15] opacity-0 scale-50 overflow-hidden"><img src="/galaxy/icono-5.png" alt="Icono 5" class="w-full h-full object-cover" /></div>
          </a>
        </div>

        <!-- Node 6 (Middle, 225° / Bottom-Left) -->
        <div class="absolute left-[25.3%] top-[74.7%]">
          <a href="/contacto" class="animate-counter-orbit absolute left-0 top-0 block group" title="Contáctanos">
            <div id="galaxy-node-6" class="liquid-node w-10 h-10 md:w-12 md:h-12 rounded-full flex items-center justify-center font-bold text-lg transition-all duration-500 group-hover:scale-[1.15] opacity-0 scale-50 overflow-hidden"><img src="/galaxy/icono-6.png" alt="Icono 6" class="w-full h-full object-cover" /></div>
          </a>
        </div>
        <!-- Node 7 (Outer, 270° / Left) -->
        <div class="absolute left-[2.5%] top-[50%]">
          <a href="/contacto" class="animate-counter-orbit absolute left-0 top-0 block group" title="Contáctanos">
            <div id="galaxy-node-7" class="liquid-node w-10 h-10 md:w-12 md:h-12 rounded-full flex items-center justify-center font-bold text-lg transition-all duration-500 group-hover:scale-[1.15] opacity-0 scale-50 overflow-hidden"><img src="/galaxy/icono-7.png" alt="Icono 7" class="w-full h-full object-cover" /></div>
          </a>
        </div>
        <!-- Node 8 (Middle, 315° / Top-Left) -->
        <div class="absolute left-[25.3%] top-[25.3%]">
          <a href="/contacto" class="animate-counter-orbit absolute left-0 top-0 block group" title="Contáctanos">
            <div id="galaxy-node-8" class="liquid-node w-10 h-10 md:w-12 md:h-12 rounded-full flex items-center justify-center font-bold text-lg transition-all duration-500 group-hover:scale-[1.15] opacity-0 scale-50 overflow-hidden"><img src="/galaxy/icono-8.png" alt="Icono 8" class="w-full h-full object-cover" /></div>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes zoomIn {
    0% { transform: scale(0.5); opacity: 0; }
    80% { transform: scale(1.05); opacity: 1; }
    100% { transform: scale(1); opacity: 1; }
  }
  .animate-zoom-in {
    opacity: 0;
    animation: zoomIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }
  
  @keyframes pulseCenter {
    0% { transform: scale(1); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); }
    50% { transform: scale(1.3); box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); }
    100% { transform: scale(1); box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05); }
  }
  .animate-pulse-center {
    animation: pulseCenter 1.5s infinite ease-in-out !important;
  }

  @keyframes orbitSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  @keyframes counterOrbitSpin {
    from { transform: translate(-50%, -50%) rotate(0deg); }
    to { transform: translate(-50%, -50%) rotate(-360deg); }
  }
  .animate-orbit {
    animation: orbitSpin 35s linear infinite;
  }
  .animate-counter-orbit {
    animation: counterOrbitSpin 35s linear infinite;
  }

  /* Reverted to Solid Black Nodes */
  .liquid-node {
    position: relative;
    background-color: transparent;
    border: none;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    color: #fff;
    transition: all 0.3s ease;
  }
  
  .group:hover .liquid-node {
    background-color: transparent;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
  }

  .liquid-node > span {
    position: relative;
    z-index: 10;
  }
</style>

<script>
  // --- Typewriter Animation ---
  const titleType = document.getElementById('hero-title-type');
  const subtitleType = document.getElementById('hero-subtitle-type');
  
  const titleHtml = "Digitaliza tu negocio.<br />Automatiza tu<br />crecimiento.";
  const subtitleHtml = "Menos tareas manuales. Más ventas, más control y procesos más inteligentes.";

  function typeWriter(element: HTMLElement | null, htmlContent: string, speed: number, delay: number, callback?: () => void) {
    if (!element) return;
    
    // Parse HTML string to handle <br /> as single tokens
    const tokens: string[] = [];
    let current = htmlContent;
    while(current.length > 0) {
      if (current.startsWith('<br />')) {
        tokens.push('<br />');
        current = current.slice(6);
      } else {
        tokens.push(current[0]);
        current = current.slice(1);
      }
    }

    setTimeout(() => {
      let i = 0;
      const interval = setInterval(() => {
        if (i < tokens.length) {
          element.innerHTML += tokens[i];
          i++;
        } else {
          clearInterval(interval);
          if (callback) callback();
        }
      }, speed);
    }, delay);
  }

  // The animated copies are currently hidden because the complete text is rendered
  // in the HTML for a faster first paint. Avoid running timers against hidden nodes.
  if (titleType && subtitleType && !titleType.classList.contains('hidden')) {
    typeWriter(titleType, titleHtml, 30, 200, () => {
      typeWriter(subtitleType, subtitleHtml, 20, 100, () => {
        const cta = document.getElementById('hero-cta');
        if (cta) {
          cta.classList.remove('opacity-0');
          cta.classList.add('animate-zoom-in');
        }
      });
    });
  }

  // Animate Galaxy Nodes from 0 to 8 while title is typing
  const animateNodes = () => {
    for (let i = 0; i <= 8; i++) {
      setTimeout(() => {
        const node = document.getElementById(`galaxy-node-${i}`);
        if (node) {
          node.classList.remove('opacity-0', 'scale-50');
          node.classList.add('opacity-100', 'scale-100');
        }
      }, 300 + (i * 200)); // Start near title typing, stagger by 200ms
    }
  };
  animateNodes();

  // --- Hover interaction on CTA ---
  const ctaBtn = document.getElementById('hero-cta');
  const centerNodeObj = document.getElementById('galaxy-node-0');
  const centerNodeImg = centerNodeObj?.querySelector('img');

  if (ctaBtn && centerNodeObj && centerNodeImg) {
    ctaBtn.addEventListener('mouseenter', () => {
      // 1 by 1 fusion animation totaling ~3 seconds
      const staggerDelay = 250; // ms
      const animDuration = 1000; // ms

      for (let i = 1; i <= 8; i++) {
        const node = document.getElementById(`galaxy-node-${i}`);
        if (node) {
          const wrapper = node.parentElement?.parentElement;
          const delay = (i - 1) * staggerDelay;
          
          if (wrapper) {
            wrapper.style.transition = `all ${animDuration}ms ease-in-out ${delay}ms`;
            wrapper.style.left = '50%';
            wrapper.style.top = '50%';
          }

          node.style.transition = `all ${animDuration}ms ease-in-out ${delay}ms`;
          node.classList.remove('opacity-100', 'scale-100');
          node.classList.add('opacity-0', 'scale-0');
        }
      }
      
      // Animate center node and change image
      centerNodeObj.classList.add('animate-pulse-center');
      centerNodeImg.src = '/galaxy/icono-9.png';
    });

    ctaBtn.addEventListener('mouseleave', () => {
      // Restore outer nodes quickly and simultaneously
      for (let i = 1; i <= 8; i++) {
        const node = document.getElementById(`galaxy-node-${i}`);
        if (node) {
          const wrapper = node.parentElement?.parentElement;
          
          if (wrapper) {
            wrapper.style.transition = `all 800ms ease-out 0ms`;
            wrapper.style.left = '';
            wrapper.style.top = '';
          }

          node.style.transition = `all 800ms ease-out 0ms`;
          node.classList.remove('opacity-0', 'scale-0');
          node.classList.add('opacity-100', 'scale-100');
        }
      }
      
      // Reset center node
      centerNodeObj.classList.remove('animate-pulse-center');
      centerNodeImg.src = '/galaxy/icono-0.png';
    });
  }

  // --- High-performance client-side repel animation ---
  const container = document.getElementById('hero-container');
  const orbs = document.querySelectorAll('.interactive-orb') as NodeListOf<HTMLElement>;

  // El efecto solo aporta interacción con mouse. En móviles se evita por completo
  // para no medir el layout ni mantener un requestAnimationFrame permanente.
  const supportsOrbInteraction = window.matchMedia('(min-width: 768px) and (pointer: fine)').matches;

  if (container && orbs.length > 0 && supportsOrbInteraction) {
    let parentRect = container.getBoundingClientRect();
    
    // Initial state storage
    let orbStates = Array.from(orbs).map((orb) => {
      const rect = orb.getBoundingClientRect();
      return {
        element: orb,
        // Store original center relative to container
        cx: (rect.left + rect.right) / 2 - parentRect.left,
        cy: (rect.top + rect.bottom) / 2 - parentRect.top,
        x: (rect.left + rect.right) / 2 - parentRect.left,
        y: (rect.top + rect.bottom) / 2 - parentRect.top,
        vx: (Math.random() - 0.5) * 3, // Initial Velocity X
        vy: (Math.random() - 0.5) * 3, // Initial Velocity Y
        radius: rect.width * 0.9, // Massive collision radius so they repel before mixing visual blurs
      };
    });

    let mouseX = -1000;
    let mouseY = -1000;
    let isHovered = false;

    // Update coordinates when window is resized
    const updateDimensions = () => {
      parentRect = container.getBoundingClientRect();
      orbStates.forEach((state) => {
        // Temporarily clear transform to calculate original position
        const prevTransform = state.element.style.transform;
        state.element.style.transform = 'none';
        const rect = state.element.getBoundingClientRect();
        state.element.style.transform = prevTransform;
        
        const newCx = (rect.left + rect.right) / 2 - parentRect.left;
        const newCy = (rect.top + rect.bottom) / 2 - parentRect.top;
        
        // Update anchor points and also shift current x/y to prevent extreme teleporting
        state.x += (newCx - state.cx);
        state.y += (newCy - state.cy);
        state.cx = newCx;
        state.cy = newCy;
        state.radius = rect.width * 0.9;
      });
    };

    window.addEventListener('resize', updateDimensions);

    container.addEventListener('mousemove', (e: MouseEvent) => {
      mouseX = e.clientX - parentRect.left;
      mouseY = e.clientY - parentRect.top;
      isHovered = true;
    });

    container.addEventListener('mouseleave', () => {
      isHovered = false;
    });

    // Physics Animation Loop
    const animate = () => {
      // 1. Update positions based on velocity and forces
      orbStates.forEach((state) => {
        // Soft tether to original anchor center so they don't fly off screen
        const dxCenter = state.cx - state.x;
        const dyCenter = state.cy - state.y;
        state.vx += dxCenter * 0.0005; 
        state.vy += dyCenter * 0.0005;

        // Apply mouse repel
        if (isHovered) {
          const dxMouse = state.x - mouseX;
          const dyMouse = state.y - mouseY;
          const distMouse = Math.sqrt(dxMouse * dxMouse + dyMouse * dyMouse);
          
          const mouseRadius = 650;
          if (distMouse < mouseRadius && distMouse > 0) {
            const force = Math.pow((mouseRadius - distMouse) / mouseRadius, 2);
            state.vx += (dxMouse / distMouse) * force * 1.5;
            state.vy += (dyMouse / distMouse) * force * 1.5;
          }
        }

        // Add some random wandering jitter
        state.vx += (Math.random() - 0.5) * 0.15;
        state.vy += (Math.random() - 0.5) * 0.15;

        // Apply friction / velocity limit
        state.vx *= 0.98;
        state.vy *= 0.98;
        
        const speed = Math.sqrt(state.vx * state.vx + state.vy * state.vy);
        const maxSpeed = 3.5;
        if (speed > maxSpeed) {
          state.vx = (state.vx / speed) * maxSpeed;
          state.vy = (state.vy / speed) * maxSpeed;
        }

        state.x += state.vx;
        state.y += state.vy;
      });

      // 2. Collision detection and response between orbs
      for (let i = 0; i < orbStates.length; i++) {
        for (let j = i + 1; j < orbStates.length; j++) {
          const a = orbStates[i];
          const b = orbStates[j];
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const minD = a.radius + b.radius;

          if (dist < minD && dist > 0) {
            // Overlapping! Push them apart
            const overlap = minD - dist;
            const nx = dx / dist;
            const ny = dy / dist;

            // Separate physically
            const separationX = nx * (overlap / 2);
            const separationY = ny * (overlap / 2);
            
            a.x -= separationX;
            a.y -= separationY;
            b.x += separationX;
            b.y += separationY;

            // Elastic bounce
            const rvx = b.vx - a.vx;
            const rvy = b.vy - a.vy;
            const velAlongNormal = rvx * nx + rvy * ny;
            
            if (velAlongNormal < 0) {
              const restitution = 0.6; // Bounciness
              const impulse = -(1 + restitution) * velAlongNormal;
              const impulseX = nx * impulse * 0.5;
              const impulseY = ny * impulse * 0.5;

              a.vx -= impulseX;
              a.vy -= impulseY;
              b.vx += impulseX;
              b.vy += impulseY;
            }
          }
        }
      }

      // 3. Render Transform
      orbStates.forEach((state) => {
        // Element's CSS relies on being relative to its original position
        const tx = state.x - state.cx;
        const ty = state.y - state.cy;
        state.element.style.transform = `translate3d(${tx.toFixed(2)}px, ${ty.toFixed(2)}px, 0)`;
      });

      requestAnimationFrame(animate);
    };

    // Run layout recalculation on load to ensure accuracy
    setTimeout(updateDimensions, 100);
    
    // Start animation loop
    requestAnimationFrame(animate);
  }
</script>
