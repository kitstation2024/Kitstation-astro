<section id="hero-container" class="relative overflow-hidden h-[680px] max-h-[680px] flex items-center bg-white pt-20">
  <!-- Interactive blurred color orbs in background -->
  <!-- Orb 1: Pink/Red (Top-Left) -->
  <div 
    class="interactive-orb absolute rounded-full blur-[80px] pointer-events-none transition-opacity duration-1000 bg-gradient-to-br from-rose-600 via-pink-600 to-red-500 opacity-100 w-[200px] h-[200px] md:w-[300px] md:h-[300px] -top-24 -left-24"
    style="will-change: transform;"
  ></div>

  <!-- Orb 2: Green/Lime (Center-Top) -->
  <div 
    class="interactive-orb absolute rounded-full blur-[100px] pointer-events-none transition-opacity duration-1000 bg-gradient-to-br from-emerald-500 via-green-500 to-lime-400 opacity-100 w-[250px] h-[250px] md:w-[350px] md:h-[350px] -top-32 left-[30%]"
    style="will-change: transform;"
  ></div>

  <!-- Orb 3: Blue (Middle-Right) -->
  <div 
    class="interactive-orb absolute rounded-full blur-[110px] pointer-events-none transition-opacity duration-1000 bg-gradient-to-br from-blue-700 via-indigo-600 to-cyan-500 opacity-100 w-[300px] h-[300px] md:w-[450px] md:h-[450px] top-[10%] -right-32"
    style="will-change: transform;"
  ></div>

  <!-- Orb 4: Yellow/Lime (Bottom-Center) -->
  <div 
    class="interactive-orb absolute rounded-full blur-[100px] pointer-events-none transition-opacity duration-1000 bg-gradient-to-br from-yellow-500 via-amber-400 to-lime-500 opacity-100 w-[250px] h-[250px] md:w-[350px] md:h-[350px] -bottom-32 left-[20%]"
    style="will-change: transform;"
  ></div>

  <!-- Foreground Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-6 md:px-12 w-full pt-8 md:pt-0 flex flex-col md:flex-row items-center justify-between gap-12">
    <div class="max-w-3xl shrink-1">
      <!-- Title Heading -->
      <h1 class="relative font-semibold text-5xl sm:text-6xl md:text-[75px] leading-[1.05] text-black tracking-tighter select-none">
        <span class="select-none">
          Digitaliza tu negocio.<br />
          Automatiza tu<br />
          crecimiento.
        </span>
        <span id="hero-title-type" class="hidden" aria-hidden="true"></span>
      </h1>
      
      <!-- Subtitle -->
      <p class="relative text-base text-gray-800 max-w-2xl mt-6 leading-relaxed font-medium">
        <span class="select-none">
          Menos tareas manuales. Más ventas, más control y procesos más inteligentes.
        </span>
        <span id="hero-subtitle-type" class="hidden" aria-hidden="true"></span>
      </p>
      
      <!-- CTA Button -->
      <div class="mt-8">
        <a 
          href="/contacto" 
          id="hero-cta"
          class="inline-block bg-transparent text-black border-2 border-black text-sm font-semibold rounded-lg px-7 py-2.5 transition-all duration-300 hover:bg-[#0066ff] hover:border-[#0066ff] hover:text-white shadow-sm"
        >
          Empieza ahora
        </a>
      </div>
    </div>

    <!-- Orbital Galaxy Component -->
    <div class="galaxy-hero-container relative shrink-0 w-[320px] h-[320px] md:w-[420px] md:h-[420px] hidden md:flex items-center justify-center">
      <!-- Rings -->
      <div class="absolute inset-0 m-auto w-[45%] h-[45%] border border-gray-400/30 rounded-full pointer-events-none"></div>
      <div class="absolute inset-0 m-auto w-[70%] h-[70%] border border-gray-400/20 rounded-full pointer-events-none"></div>
      <div class="absolute inset-0 m-auto w-[95%] h-[95%] border border-gray-400/10 rounded-full pointer-events-none"></div>

      <!-- Center Node 0 -->
      <div id="galaxy-node-0" class="liquid-node absolute inset-0 m-auto w-16 h-16 md:w-20 md:h-20 rounded-full flex items-center justify-center font-bold text-2xl pointer-events-none z-10 opacity-0 scale-50 transition-all duration-500">
        <img src="/galaxy/icono-0.png" alt="Icono 0" class="w-full h-full object-cover rounded-full" />
      </div>

      <!-- Rotating Container -->
      <div class="absolute inset-0 w-full h-full animate-orbit">
        
        <!-- Node 1 (Outer, 0° / Top) -->
        <div class="absolute left-[50%] top-[2.5%]">
          <a href="/contacto" class="animate-counter-orbit absolute left-0 top-0 block group" title="Contáctanos">
            <div id="galaxy-node-1" class="liquid-node w-10 h-10 md:w-12 md:h-12 rounded-full flex items-center justify-center font-bold text-lg transition-all duration-500 group-hover:scale-[1.15] opacity-0 scale-50 overflow-hidden"><img src="/galaxy/icono-1.png" alt="Icono 1" class="w-full h-full object-cover" /></div>
