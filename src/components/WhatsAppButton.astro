---

<div class="live-linkstation-widget" aria-label="Canales de contacto de LinkStation">
  <input class="live-linkstation-widget__toggle" type="checkbox" id="live-linkstation-toggle" />
  <div class="live-linkstation-widget__channels">
    {channels.map((channel) => (
      <a
        class={`live-linkstation-widget__channel ${channel.className}`}
        href={channel.href}
        target={channel.href.startsWith("mailto:") ? undefined : "_blank"}
        rel={channel.href.startsWith("mailto:") ? undefined : "noreferrer"}
        aria-label={`Contactar por ${channel.name}`}
        set:html={channel.icon}
      />
    ))}
  </div>
  <label class="live-linkstation-widget__button" for="live-linkstation-toggle" aria-label="Abrir canales de contacto">
    <span class="live-linkstation-widget__button-icon live-linkstation-widget__button-icon--open" aria-hidden="true">
      <svg viewBox="0 0 28 28" fill="none">
        <path d="M6.2 5.5h11.6a3.2 3.2 0 0 1 3.2 3.2v7.1a3.2 3.2 0 0 1-3.2 3.2h-4.1l-4.4 3.4V19H6.2A3.2 3.2 0 0 1 3 15.8V8.7a3.2 3.2 0 0 1 3.2-3.2Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/>
        <path d="M9.3 2.8h11.5A3.2 3.2 0 0 1 24 6v7.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/>
      </svg>
    </span>
    <span class="live-linkstation-widget__button-icon live-linkstation-widget__button-icon--close" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <path d="m6.75 6.75 10.5 10.5m0-10.5-10.5 10.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
      </svg>
    </span>
  </label>
  <span class="live-linkstation-widget__powered">Linkstation</span>
</div>
