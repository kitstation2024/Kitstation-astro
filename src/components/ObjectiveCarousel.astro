<style>
  /* Hide native scrollbar */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  const track = document.getElementById('carousel-track');

  if (track) {
    // 1. Clone cards for infinite loop
    const originalCards = Array.from(track.children);
    // Clone 4 times to ensure a huge buffer for fast scrolling
    for (let i = 0; i < 4; i++) {
      originalCards.forEach(card => track.appendChild(card.cloneNode(true)));
    }

    const cardGap = 24;
    const mobileQuery = window.matchMedia('(max-width: 767px)');
    let cardWidth = mobileQuery.matches ? 280 : 320;
    let jumpDistance = originalCards.length * (cardWidth + cardGap);

    const updateCarouselMetrics = () => {
      cardWidth = mobileQuery.matches ? 280 : 320;
      jumpDistance = originalCards.length * (cardWidth + cardGap);
    };

    mobileQuery.addEventListener('change', updateCarouselMetrics);

    let isHovered = false;
    let isNativeScrolling = false;

    // Track dragging state
    let isDraggingTrack = false;
    let trackDragStartX = 0;
    let trackInitialScroll = 0;
    let hasDraggedTrack = false; // To prevent click after drag
    
    // Custom scrollbar dragging state
    let isDraggingThumb = false;
    let dragStartX = 0;
    let dragInitialScroll = 0;
    let dragInitialProgress = 0;

    // Controladores de los botones de flechas (< y >)
    const prevBtn = document.getElementById('carousel-prev-btn');
    const nextBtn = document.getElementById('carousel-next-btn');

    let isPermanentlyPaused = false;

    // Resumir el auto-desplazamiento si el usuario hace scroll en la página
    window.addEventListener('scroll', () => {
      if (isPermanentlyPaused) {
        isPermanentlyPaused = false;
      }
    }, { passive: true });

    const getNearestCardScrollLeft = (direction: number) => {
      const cardCount = track.children.length;
      const trackCenter = track.scrollLeft + track.clientWidth / 2;
      const firstCardCenter = mobileQuery.matches ? track.clientWidth / 2 : 48 + cardWidth / 2;
      const cardStep = cardWidth + cardGap;
      const nearestIndex = Math.round((trackCenter - firstCardCenter) / cardStep);

      let targetIndex = nearestIndex + direction;
      if (targetIndex < 0) targetIndex = 0;
      if (targetIndex >= cardCount) targetIndex = cardCount - 1;

      return firstCardCenter + targetIndex * cardStep - track.clientWidth / 2;
    };

    const centerTrackIfNeeded = () => {
      const jumpDist = getJumpDistance();
      if (jumpDist > 0) {
        if (track.scrollLeft > jumpDist * 3) {
          track.scrollLeft -= jumpDist;
        } else if (track.scrollLeft < jumpDist * 1) {
          track.scrollLeft += jumpDist;
        }
      }
    };

    prevBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      isPermanentlyPaused = true;
      currentVelocity = 0;
      centerTrackIfNeeded();
      const targetScroll = getNearestCardScrollLeft(-1);
      track.scrollTo({ left: targetScroll, behavior: 'smooth' });
    });

    nextBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      isPermanentlyPaused = true;
      currentVelocity = 0;
      centerTrackIfNeeded();
      const targetScroll = getNearestCardScrollLeft(1);
      track.scrollTo({ left: targetScroll, behavior: 'smooth' });
    });

    // Lógica táctil para abrir/cerrar tarjetas al tocar en móviles
    const setupCardToggles = () => {
      const allCards = Array.from(track.children) as HTMLElement[];
      allCards.forEach(card => {
        // Listener para el botón X de cerrar
        const closeBtn = card.querySelector('.close-card-btn');
        closeBtn?.addEventListener('click', (e) => {
          e.stopPropagation();
          card.classList.remove('is-open');
        });

        card.addEventListener('click', (e) => {
          // Prevent opening card if we just finished a drag
          if (hasDraggedTrack) {
            e.preventDefault();
            return;
          }

          // Si hace clic en el enlace interno o en el botón X, omitir
          if ((e.target as HTMLElement).closest('a') || (e.target as HTMLElement).closest('.close-card-btn')) return;

          const isOpen = card.classList.contains('is-open');
          // Cerrar otras tarjetas abiertas
          allCards.forEach(c => c.classList.remove('is-open'));
          if (!isOpen) {
            card.classList.add('is-open');
          } else {
            card.classList.remove('is-open');
          }
        });
      });
    };

    // Inicializar listeners táctiles
    setupCardToggles();

    // Mouse drag directly on the track
    track.addEventListener('mousedown', (e) => {
      if ((e.target as HTMLElement).closest('a') || (e.target as HTMLElement).closest('button') || (e.target as HTMLElement).closest('.close-card-btn')) return;
      
      isDraggingTrack = true;
      hasDraggedTrack = false;
      isNativeScrolling = true;
      isPermanentlyPaused = true;
      currentVelocity = 0;
      trackDragStartX = e.clientX;
      trackInitialScroll = track.scrollLeft;
      track.style.cursor = 'grabbing';
      track.style.userSelect = 'none';
    });

    window.addEventListener('mousemove', (e) => {
      if (isDraggingTrack) {
        const dx = e.clientX - trackDragStartX;
        if (Math.abs(dx) > 5) {
           hasDraggedTrack = true;
        }
        track.scrollLeft = trackInitialScroll - dx;
      }
    });

    window.addEventListener('mouseup', () => {
      if (isDraggingTrack) {
        isDraggingTrack = false;
        track.style.cursor = '';
        track.style.userSelect = '';
        setTimeout(() => {
          isNativeScrolling = false;
        }, 100);
        setTimeout(() => {
          hasDraggedTrack = false;
        }, 0);
      }
    });

    // Para que en móvil no se bloquee de forma permanente accidentalmente por toques ligeros,
    // pero que pause mientras interactúan.
    track.addEventListener('touchstart', () => { isNativeScrolling = true; currentVelocity = 0; isPermanentlyPaused = true; }, { passive: true });
    track.addEventListener('touchend', () => { setTimeout(() => isNativeScrolling = false, 100); });

    // The card widths and gap are fixed by the component's responsive classes.
    // Keeping this metric cached avoids forcing layout on every animation frame.
    const getJumpDistance = () => {
      return jumpDistance;
    };

    // Custom Scrollbar Logic
    const scrollThumb = document.getElementById('custom-scrollbar-thumb');
    const scrollTrack = document.getElementById('custom-scrollbar-track');

    if (scrollThumb && scrollTrack) {
      let scrollbarMaxTranslate = 0;

      const updateThumbPosition = () => {
        if (scrollThumb && scrollTrack) {
          const jump = getJumpDistance();
          if (jump > 1) {
             let progress;
             if (isDraggingThumb) {
               let deltaScroll = track.scrollLeft - dragInitialScroll;
               progress = dragInitialProgress + (deltaScroll / jump);
             } else {
               progress = (track.scrollLeft % jump) / jump;
               if (progress < 0) progress += 1;
             }
             
             if (progress < 0) progress = 0;
             if (progress > 1) progress = 1;
             
             scrollThumb.style.transform = `translateX(${progress * scrollbarMaxTranslate}px)`;
          }
        }
      };

      const onThumbMouseMove = (e: MouseEvent) => {
        if (!isDraggingThumb) return;
        const dx = e.clientX - dragStartX;
        const maxTx = scrollbarMaxTranslate;
        if (maxTx <= 0) return;
        const jump = getJumpDistance();
        
        let deltaProgress = dx / maxTx;
        let newProgress = dragInitialProgress + deltaProgress;
        
        if (newProgress < 0) newProgress = 0;
        if (newProgress > 1) newProgress = 1;
        
        let clampedDeltaProgress = newProgress - dragInitialProgress;
        let newScroll = dragInitialScroll + clampedDeltaProgress * jump;
        
        track.scrollLeft = newScroll;
      };

      const onThumbMouseUp = () => {
        isDraggingThumb = false;
        isNativeScrolling = false;
        window.removeEventListener('mousemove', onThumbMouseMove);
        window.removeEventListener('mouseup', onThumbMouseUp);
      };

      scrollThumb.addEventListener('mousedown', (e) => {
        e.preventDefault();
        isDraggingThumb = true;
        isNativeScrolling = true; // Pause auto-scroll
        currentVelocity = 0; // stop auto-scroll immediately
        dragStartX = e.clientX;
        dragInitialScroll = track.scrollLeft;
        
        const jump = getJumpDistance();
        let initialProgress = (dragInitialScroll % jump) / jump;
        if (initialProgress < 0) initialProgress += 1;
        dragInitialProgress = initialProgress;
        
        window.addEventListener('mousemove', onThumbMouseMove);
        window.addEventListener('mouseup', onThumbMouseUp);
      });

      const scrollbarObserver = new ResizeObserver(([entry]) => {
        // The thumb is 25% of the track, so its available travel is 75%.
        scrollbarMaxTranslate = entry.contentRect.width * 0.75;
        updateThumbPosition();
      });
      scrollbarObserver.observe(scrollTrack);
      
      track.addEventListener('scroll', updateThumbPosition, { passive: true });
    }

    // 3. Auto Scroll Animation with Smooth Velocity (Lerp)
    let currentVelocity = 0.5;
    let targetVelocity = 0.5;

    const autoScroll = () => {
      // Determine target speed based on user interaction
      const normalSpeed = mobileQuery.matches ? 0.5 : 0.8;
      
      if (isNativeScrolling || isPermanentlyPaused) {
        targetVelocity = 0;
      } else {
        targetVelocity = normalSpeed;
      }

      // Smoothly transition current velocity towards target 
      currentVelocity += (targetVelocity - currentVelocity) * 0.35;

      const jumpDist = getJumpDistance();
      if (!isNativeScrolling && currentVelocity > 0.01) {
        let nextScroll = track.scrollLeft + currentVelocity;

        // Wrap before writing, avoiding a layout read immediately after a DOM write.
        if (jumpDist > 0 && !isDraggingThumb && !isDraggingTrack) {
          if (nextScroll > jumpDist * 3) {
            nextScroll -= jumpDist;
          } else if (nextScroll < jumpDist) {
            nextScroll += jumpDist;
          }
        }

        track.scrollLeft = nextScroll;
      }
      
      requestAnimationFrame(autoScroll);
    };

    const startCarousel = () => {
      // Set the known initial position without first querying layout-dependent scroll data.
      track.scrollLeft = getJumpDistance() * 2;
      requestAnimationFrame(autoScroll);
    };

    if (document.readyState === 'complete') {
      startCarousel();
    } else {
      window.addEventListener('load', startCarousel, { once: true });
    }
  }
</script>
