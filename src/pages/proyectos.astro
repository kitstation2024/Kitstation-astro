---
import Layout from '../layouts/Layout.astro';
import HeaderKit from '../components/HeaderKit.astro';
import IAChatDemo from '../components/IAChatDemo.astro';

type Project = {
  title: string;
  description?: string;
  media: string | null;
  poster?: string;
  type: string;
  tags: string[];
  startTime?: number;
  isWide?: boolean;
  url?: string;
};

type Service = {
  id: string;
  name: string;
  formattedName: string;
  colorClass: string;
  rgb: string;
  circleImage: string;
  projects: Project[];
};

const services: Service[] = [
  { 
    id: 'web', name: 'Diseño y desarrollo web', formattedName: 'Diseño y<br />desarrollo web', colorClass: 'bg-[#c4a3f8]', rgb: '196, 163, 248',
    circleImage: '/images/projects/web/circulo-web.jpg',
    projects: [
      { title: 'Exiven', description: 'Catálogo digital autogestionable en WordPress, optimizado para la exhibición ágil de productos.', media: '/videos/diseno-web/diseno-web-portafolio.mp4', poster: '/images/projects/web/1-Web-Exiven.jpg', type: 'video', tags: ['catálogo', 'web'], url: 'https://www.exiven.com/' },
      { title: 'Bodega Olcese', description: 'E-commerce con logística dual (entregas inmediatas o programadas) y cálculo de envío dinámico por zonas.', media: '/videos/diseno-web/diseno-web-ecomerce-2.mp4', poster: '/images/projects/web/2-Web-bodegaolcese.jpg', type: 'video', tags: ['e-commerce', 'logística'], url: 'https://bodegaolcese.pe/' },
      { title: 'Versounited', description: 'Portafolio 3D inmersivo desarrollado en Astro y Three.js, con físicas de movimiento en tiempo real.', media: '/videos/diseno-web/diseno-web-3d.mp4', poster: '/images/projects/web/3-web-versounited.jpg', type: 'video', tags: ['portfolio', '3D'], url: 'https://versounited.com/' },
      { title: 'Alfra', description: 'Landing page financiera orientada a la conversión, con embudo integrado para segmentación de leads.', media: '/videos/diseno-web/diseno-web-corporativas.mp4', poster: '/images/projects/web/4-web-alfra.jpg', type: 'video', tags: ['landing page', 'finanzas'], url: 'https://www.contadoresalfra.pe/' },
      { title: 'Corfrut', description: 'Catálogo corporativo bilingüe (ES/EN) estructurado para el posicionamiento de productos de exportación B2B.', media: '/videos/diseno-web/diseno-web-multilenguaje.mp4', poster: '/images/projects/web/5-web-corfrut.jpg', type: 'video', tags: ['web corporativa', 'B2B'], url: 'https://corfrutfresh.com/' },
      { title: 'EvilWorld', description: 'Tienda en línea optimizada para conversiones con pasarelas de pago y gestión de inventario.', media: '/videos/diseno-web/diseno-web-ecomerce.mp4', type: 'video', tags: ['e-commerce'], url: 'https://evilworld.pe/' },
      { title: 'Smarticket', description: 'Estructura de impacto orientada a máxima conversión, diseñada para transformar clics en ventas reales.', media: '/videos/diseno-web/diseno-web-landing.mp4', type: 'video', tags: ['landing page', 'ventas'], url: 'https://www.smarticket.pe/' }
    ]
  },
  { 
    id: 'ia', name: 'Automatizaciones con IA', formattedName: 'Automatizaciones<br />con IA', colorClass: 'bg-[#52a0ff]', rgb: '82, 160, 255',
    circleImage: '/images/projects/ia/circulo-ia.jpg',
    projects: [] // Se muestra la interfaz del Chat
  },
  /*
  { 
    id: 'software', name: 'Desarrollo de software', formattedName: 'Desarrollo de<br />software', colorClass: 'bg-[#187ab0]', rgb: '24, 122, 176',
    circleImage: '/images/projects/software/circulo-software.jpg',
    projects: [
      { title: 'Linkstation', description: 'Sistema de mensajería unificada, diseñado para centralizar y agilizar toda la comunicación en una sola plataforma.', media: '/images/projects/software/1-crm-linksation.jpg', type: 'image', tags: ['software', 'CRM'] }
    ]
  },
  */
  { 
    id: 'marca', name: 'Identidad de marca', formattedName: 'Identidad de<br />marca', colorClass: 'bg-[#ff9768]', rgb: '255, 151, 104',
    circleImage: '/images/projects/marca/circulo-marca.jpg',
    projects: [
      { title: 'Animación 2D', description: 'Pieza híbrida desarrollada con la suite Adobe (After Effects, Illustrator, Photoshop), que integra elementos 3D en secuencias clave para aportar profundidad y dinamismo visual.', media: '/images/projects/marca/2-2D.mp4', type: 'video', tags: ['animación', '2D'], startTime: 4.6 },
      { title: 'Corrección de color', description: 'Etalonaje profesional en DaVinci Resolve para campaña de moda (fashion film), enfocado en potenciar la estética y consolidar la identidad visual de la marca.', media: '/images/projects/marca/3-CORRECCION.mp4', type: 'video', tags: ['video', 'color'], startTime: 148.26 },
      { title: 'Efectos visuales (VFX)', description: 'Integración de efectos digitales para una campaña estacional de Halloween (Ignacio Baladán), orientada a maximizar el engagement y la retención en redes sociales.', media: '/images/projects/marca/4-EFECTOS-V.mp4', type: 'video', tags: ['VFX', 'campaña'] },
      { title: 'Animación 3D', description: 'Producción y secuenciación visual (Blender, Cinema 4D, Premiere Pro) ejecutada por Kitstation, transformando el guion original del cliente en una pieza inmersiva de alto impacto.', media: '/images/projects/marca/1-3D.mp4', type: 'video', tags: ['animación', '3D'], isWide: true }
    ]
  }
];

const allProjects = services.flatMap(service => 
  service.projects.map(p => ({
    category: service.id,
    title: p.title,
    description: p.description || "dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod dolor sit amet, consectetuer adipiscing elit, sed diam nonummy nibh euismod",
    url: p.url || "#",
    tags: p.tags,
    media: p.media,
    poster: p.poster,
    mediaType: p.type,
    isWide: p.isWide,
    startTime: p.startTime || 0
  }))
);
---

<Layout title="Proyectos - KitStation" bodyClass="bg-[#000000] text-white relative overflow-x-hidden min-h-screen">
  <HeaderKit />
  
  <main id="projects-container" class="relative z-10 pt-[140px] pb-32 px-5 sm:px-8 md:px-12 max-w-[1200px] mx-auto min-h-screen">

    <!-- Header Section -->
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl lg:text-[56px] font-semibold mb-5 tracking-tight text-white">Nuestros proyectos</h1>
      <p class="text-gray-300 text-sm md:text-base max-w-2xl mx-auto font-light">
        Descubre nuestros proyectos y como hemos ayudado a empresas a digitalizarse.
      </p>
    </div>
    
    <!-- Category Circles (Fila única de 3 esferas en móvil con títulos en 2 líneas) -->
    <div class="grid grid-cols-3 gap-2 sm:gap-4 md:gap-6 max-w-3xl mx-auto mb-20 px-2 justify-items-center">
      {services.filter(s => s.id !== 'software').map((service, index) => (
        <div class={`group flex flex-col items-center cursor-pointer w-full ${index === 0 ? 'is-active' : ''}`}>
          <div 
            class={`service-circle w-[72px] h-[72px] sm:w-[120px] sm:h-[120px] md:w-[160px] md:h-[160px] rounded-full ${service.colorClass} cursor-pointer transition-all duration-300 transform hover:scale-105 shadow-lg overflow-hidden relative ${index === 0 ? 'scale-110' : ''}`}
            data-rgb={service.rgb}
            data-category={service.id}
            style={index === 0 ? `box-shadow: 0 0 0 4px rgb(${service.rgb})` : ''}
          >
            {service.circleImage && (
              <img src={service.circleImage} alt={service.name} class="w-full h-full object-cover absolute inset-0 z-10" />
            )}
          </div>
          <span 
            class="service-label text-[11px] sm:text-xs md:text-sm text-center font-medium leading-tight mt-3 text-white transition-opacity duration-300 pointer-events-none opacity-100 md:opacity-0 md:group-hover:opacity-100 group-[.is-active]:opacity-100"
            set:html={service.formattedName}
          />
        </div>
      ))}
    </div>

    <!-- Content Area (Grid / Chat Stacker) -->
    <div class="grid grid-cols-1 grid-rows-1">
      
      <!-- Projects Grid -->
      <div id="projects-grid" class="col-start-1 row-start-1 grid grid-cols-1 md:grid-cols-2 gap-x-8 md:gap-x-10 gap-y-12 md:gap-y-14 min-h-[500px] content-start transition-all duration-500 ease-in-out opacity-100 scale-100">
        {allProjects.map((project) => (
          <div 
            class={`project-card group transition-all duration-500 ease-in-out flex flex-col transform origin-top ${project.category === 'web' ? 'opacity-100 scale-100' : 'hidden opacity-0 scale-95'} ${project.category === 'marca' && !project.isWide ? 'max-w-[320px] mx-auto' : 'w-full'}`}
            data-category={project.category}
          >
            <div class={`video-container w-full ${project.category === 'marca' && !project.isWide ? 'aspect-[9/16]' : 'aspect-[1.64]'} bg-[#111] rounded-[16px] overflow-hidden relative border border-white/20`}>
              {project.media ? (
                project.mediaType === 'video' ? (
                  <video src={`${project.media}${project.startTime ? `#t=${project.startTime}` : ''}`} poster={project.poster} data-start-time={project.startTime} preload="metadata" loop muted playsinline class={`w-full h-full ${project.isWide ? 'object-contain' : 'object-cover'} border-0 focus:outline-none pointer-events-none`}></video>
                ) : (
                  <img src={project.media} alt={project.title} class="w-full h-full object-cover" />
                )
              ) : (
                <div class="w-full h-full flex flex-col items-center justify-center text-[#444] bg-[#1a1a1a]">
                  <i class="bi bi-image text-3xl mb-2"></i>
                  <span class="text-xs font-semibold">Próximamente</span>
                </div>
              )}
              {project.category === 'web' && project.url !== '#' && (
                <a href={project.url} target="_blank" rel="noopener noreferrer" class="absolute inset-0 z-10" aria-label={`Visitar sitio web de ${project.title}`}></a>
              )}
              {project.category === 'marca' && (
                <div class="absolute bottom-3 right-3 z-10 flex gap-2 md:opacity-0 md:group-hover:opacity-100 md:focus-within:opacity-100 transition-opacity">
                  <button type="button" class="btn-play-action flex items-center gap-1.5 text-xs font-medium text-white bg-black/70 hover:bg-black/90 border border-white/30 px-3 py-2 rounded-md" aria-label={`Reproducir video de ${project.title}`}>
                    <i class="bi bi-play-fill text-base"></i> Reproducir
                  </button>
                  <button type="button" class="btn-expand-action flex items-center justify-center text-white bg-black/70 hover:bg-black/90 border border-white/30 w-9 h-9 rounded-md" title="Pantalla completa" aria-label={`Ver ${project.title} en pantalla completa`}>
                    <i class="bi bi-arrows-fullscreen"></i>
                  </button>
                </div>
              )}
            </div>
            
            <div class="pt-3">
              <h3 class="text-white font-normal text-xl sm:text-[23px] leading-tight tracking-tight">
                {project.category === 'web' && project.url !== '#' ? (
                  <a href={project.url} target="_blank" rel="noopener noreferrer" class="hover:underline underline-offset-4">{project.title}</a>
                ) : project.title}
              </h3>
              <div class="flex flex-wrap gap-1.5 mt-2.5" aria-label={`Categorías de ${project.title}`}>
                {project.tags.map((tag) => (
                  <span class="inline-flex items-center rounded-full border border-white/55 px-2 py-0.5 text-[11px] leading-none font-normal text-white/85">{tag}</span>
                ))}
              </div>
              <p class="sr-only">{project.description}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- IA Chat Section -->
      <div id="ia-chat-section" class="col-start-1 row-start-1 hidden transition-all duration-500 ease-in-out opacity-0 scale-95 z-20">
        <IAChatDemo />
      </div>

      <!-- Custom Video Lightbox -->
      <div id="custom-lightbox" class="fixed inset-0 z-[9999] flex flex-col bg-black/95 opacity-0 pointer-events-none transition-opacity duration-300 pt-[80px]">
        
        <div id="lightbox-content" class="relative w-full flex-1 flex items-center justify-center overflow-hidden cursor-pointer">
          <video id="lightbox-video" class="pointer-events-none rounded-[24px] shadow-[0_0_50px_rgba(0,0,0,0.5)] transition-all duration-300 w-auto max-w-[82%] max-h-[78%] md:max-w-[90%] md:max-h-[90%]" style="height: 100%;" loop muted playsinline></video>
        </div>

        <div class="w-full pb-20 sm:pb-8 pt-4 px-6 flex items-center justify-center gap-4">
          <button type="button" id="lightbox-play-btn" class="flex items-center gap-2 text-sm font-semibold text-white bg-white/10 hover:bg-white/20 border border-white/20 px-8 py-3 rounded-lg transition-all tracking-wider shadow-lg">
            <i class="bi bi-pause-fill text-xl" id="lightbox-play-icon"></i> <span id="lightbox-play-text">Pausar</span>
          </button>
          
          <button id="lightbox-close" type="button" class="flex items-center justify-center text-sm font-semibold text-white bg-white/10 hover:bg-white/20 border border-white/20 w-[46px] h-[46px] rounded-lg transition-all shadow-lg" title="Cerrar">
            <i class="bi bi-x-lg text-lg"></i>
          </button>
        </div>
      </div>

    </div>
  </main>
</Layout>

<script>
  const circles = document.querySelectorAll('.service-circle') as NodeListOf<HTMLElement>;
  const projectCards = document.querySelectorAll('.project-card');
  const projectsGrid = document.getElementById('projects-grid');
  const chatSection = document.getElementById('ia-chat-section');

  circles.forEach(circle => {
    circle.addEventListener('click', () => {
      circles.forEach(c => {
        c.classList.remove('scale-110');
        c.style.boxShadow = 'none';
        c.closest('.group')?.classList.remove('is-active');
      });
      circle.classList.add('scale-110');
      
      const rgb = circle.getAttribute('data-rgb');
      if (rgb) {
        circle.style.boxShadow = `0 0 0 4px rgb(${rgb})`;
      }
      circle.closest('.group')?.classList.add('is-active');

      const category = circle.getAttribute('data-category');
      const isChatActive = chatSection && !chatSection.classList.contains('hidden');

      if (category === 'ia') {
        if (!isChatActive && projectsGrid && chatSection) {
          // Hide grid, show chat
          projectsGrid.classList.add('opacity-0', 'scale-95');
          setTimeout(() => {
            projectsGrid.classList.add('hidden');
            
            chatSection.classList.remove('hidden');
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                chatSection.classList.remove('opacity-0', 'scale-95');
                chatSection.classList.add('opacity-100', 'scale-100');
              });
            });
          }, 400);
        }
      } else {
        if (isChatActive && projectsGrid && chatSection) {
          // Hide chat, show grid, and update cards
          chatSection.classList.add('opacity-0', 'scale-95');
          chatSection.classList.remove('opacity-100', 'scale-100');
          setTimeout(() => {
            chatSection.classList.add('hidden');
            
            if (category === 'marca') {
              projectsGrid.classList.remove('md:grid-cols-2');
              projectsGrid.classList.add('md:grid-cols-3', 'lg:grid-cols-3');
            } else {
              projectsGrid.classList.remove('md:grid-cols-3', 'lg:grid-cols-3');
              projectsGrid.classList.add('md:grid-cols-2');
            }
            
            projectsGrid.classList.remove('hidden');
            
            // PREPARE CARDS
            let delayIndex = 0;
            projectCards.forEach(card => {
              if (card.getAttribute('data-category') !== category) {
                card.classList.add('hidden');
                card.classList.remove('opacity-100', 'scale-100');
                card.classList.add('opacity-0', 'scale-95');
              } else {
                card.classList.remove('hidden');
                setTimeout(() => {
                  card.classList.remove('opacity-0', 'scale-95');
                  card.classList.add('opacity-100', 'scale-100');
                }, delayIndex * 100);
                delayIndex++;
              }
            });
            
            requestAnimationFrame(() => {
              requestAnimationFrame(() => {
                projectsGrid.classList.remove('opacity-0', 'scale-95');
                projectsGrid.classList.add('opacity-100', 'scale-100');
              });
            });
          }, 400);
        } else {
          // Normal card to card transition
          let isAnyHiding = false;
          projectCards.forEach(card => {
            if (card.getAttribute('data-category') !== category && !card.classList.contains('hidden')) {
              card.classList.add('opacity-0', 'scale-95');
              card.classList.remove('opacity-100', 'scale-100');
              isAnyHiding = true;
            }
          });

          const showNewCards = () => {
            if (!projectsGrid) return;
            if (category === 'marca') {
              projectsGrid.classList.remove('md:grid-cols-2');
              projectsGrid.classList.add('md:grid-cols-3', 'lg:grid-cols-3');
            } else {
              projectsGrid.classList.remove('md:grid-cols-3', 'lg:grid-cols-3');
              projectsGrid.classList.add('md:grid-cols-2');
            }
            
            let delayIndex = 0;
            projectCards.forEach(card => {
              if (card.getAttribute('data-category') !== category) {
                card.classList.add('hidden');
              } else {
                card.classList.remove('hidden');
                requestAnimationFrame(() => {
                  requestAnimationFrame(() => {
                    setTimeout(() => {
                      card.classList.remove('opacity-0', 'scale-95');
                      card.classList.add('opacity-100', 'scale-100');
                    }, delayIndex * 100);
                    delayIndex++;
                  });
                });
              }
            });
          };

          if (isAnyHiding) {
            setTimeout(showNewCards, 400);
          } else {
            showNewCards();
          }
        }
      }
    });
  });

  // Video logic for mobile and desktop
  const videoObserver = new IntersectionObserver((entries) => {
    const isMobile = window.innerWidth < 768;
    entries.forEach(entry => {
      const video = entry.target as HTMLVideoElement;
      const card = video.closest('.project-card');
      const category = card?.getAttribute('data-category');
      
      if (isMobile && category === 'web') {
        if (entry.isIntersecting) {
          video.play().catch(e => console.log("Intersection play interrupted", e));
        } else {
          video.pause();
        }
      }
    });
  }, { threshold: 0.5 }); // Require 50% visibility

  projectCards.forEach(card => {
    const video = card.querySelector('video');
    if (video) {
      videoObserver.observe(video);
      
      const startTime = parseFloat(video.getAttribute('data-start-time') || '0');
      const category = card.getAttribute('data-category');
      const videoContainer = card.querySelector('.video-container');
      const btnPlay = card.querySelector('.btn-play-action');
      const btnExpand = card.querySelector('.btn-expand-action');

      // Sync button state with video events
      video.addEventListener('play', () => {
        if (btnPlay) btnPlay.innerHTML = `<i class="bi bi-pause-fill text-lg"></i> Pausar`;
      });
      video.addEventListener('pause', () => {
        if (btnPlay) btnPlay.innerHTML = `<i class="bi bi-play-fill text-lg"></i> Reproducir`;
      });

      // Desktop Hover Behavior
      card.addEventListener('mouseenter', () => {
        if (window.innerWidth >= 768) {
          video.play().catch(e => console.log("Hover play interrupted", e));
        }
      });
      card.addEventListener('mouseleave', () => {
        if (window.innerWidth >= 768) {
          video.pause();
          video.currentTime = startTime;
        }
      });

      // Click Behaviors for 'marca'
      if (category === 'marca') {
        const togglePlay = (e?: Event) => {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          if (video.paused) {
            video.play();
          } else {
            video.pause();
          }
        };

        if (videoContainer) {
          videoContainer.addEventListener('click', (e) => {
            if (window.innerWidth < 768) {
              togglePlay(e);
            }
          });
        }

        if (btnPlay) {
          btnPlay.addEventListener('click', togglePlay);
        }

        if (btnExpand) {
          btnExpand.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            if (typeof (window as any).openLightbox === 'function') {
              const isWide = video.classList.contains('object-contain');
              (window as any).openLightbox(video.src, startTime, isWide);
              video.pause();
            }
          });
        }
      }
    }
  });

  // Lightbox Logic
  const lightbox = document.getElementById('custom-lightbox');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxContent = document.getElementById('lightbox-content');
  const lightboxVideo = document.getElementById('lightbox-video') as HTMLVideoElement;
  const lightboxPlayBtn = document.getElementById('lightbox-play-btn');
  const lightboxPlayIcon = document.getElementById('lightbox-play-icon');
  const lightboxPlayText = document.getElementById('lightbox-play-text');

  (window as any).openLightbox = (src: string, startTime: number, isWide: boolean) => {
    if (!lightbox || !lightboxVideo) return;
    lightboxVideo.src = src;
    lightboxVideo.currentTime = startTime;
    
    if (isWide) {
      lightboxVideo.style.aspectRatio = '16 / 9';
      lightboxVideo.style.objectFit = 'contain';
    } else {
      lightboxVideo.style.aspectRatio = '9 / 16';
      lightboxVideo.style.objectFit = 'cover';
    }

    lightbox.classList.remove('opacity-0', 'pointer-events-none');
    lightbox.classList.add('opacity-100', 'pointer-events-auto');
    
    lightboxVideo.play().catch(e => console.log("Lightbox play error", e));
  };

  const closeLightbox = () => {
    if (!lightbox || !lightboxVideo) return;
    lightbox.classList.remove('opacity-100', 'pointer-events-auto');
    lightbox.classList.add('opacity-0', 'pointer-events-none');
    lightboxVideo.pause();
    setTimeout(() => { lightboxVideo.src = ''; }, 300); // clear after fade out
  };

  if (lightboxClose) {
    lightboxClose.addEventListener('click', closeLightbox);
  }

  const toggleLightboxPlay = (e?: Event) => {
    if (e) e.stopPropagation();
    if (lightboxVideo.paused) {
      lightboxVideo.play();
    } else {
      lightboxVideo.pause();
    }
  };

  if (lightboxContent) {
    lightboxContent.addEventListener('click', toggleLightboxPlay);
  }
  
  if (lightboxPlayBtn) {
    lightboxPlayBtn.addEventListener('click', toggleLightboxPlay);
  }

  if (lightboxVideo && lightboxPlayIcon && lightboxPlayText) {
    lightboxVideo.addEventListener('play', () => {
      lightboxPlayIcon.classList.replace('bi-play-fill', 'bi-pause-fill');
      lightboxPlayText.textContent = 'Pausar';
    });

    lightboxVideo.addEventListener('pause', () => {
      lightboxPlayIcon.classList.replace('bi-pause-fill', 'bi-play-fill');
      lightboxPlayText.textContent = 'Reproducir';
    });
  }

  if (orbs.length > 0) {
    let orbStates = Array.from(orbs).map((orb) => {
      const rect = orb.getBoundingClientRect();
      return {
        element: orb,
        cx: (rect.left + rect.right) / 2,
        cy: (rect.top + rect.bottom) / 2,
        x: (rect.left + rect.right) / 2,
        y: (rect.top + rect.bottom) / 2,
        vx: (Math.random() - 0.5) * 2.5,
        vy: (Math.random() - 0.5) * 2.5,
        radius: rect.width * 0.9,
      };
    });

    let mouseX = -1000;
    let mouseY = -1000;
    let isHovered = false;

    const updateDimensions = () => {
      orbStates.forEach((state) => {
        const prevTransform = state.element.style.transform;
        state.element.style.transform = 'none';
        const rect = state.element.getBoundingClientRect();
        state.element.style.transform = prevTransform;
        
        const newCx = (rect.left + rect.right) / 2;
        const newCy = (rect.top + rect.bottom) / 2;
        
        state.x += (newCx - state.cx);
        state.y += (newCy - state.cy);
        state.cx = newCx;
        state.cy = newCy;
        state.radius = rect.width * 0.9;
      });
    };

    window.addEventListener('resize', updateDimensions);
    window.addEventListener('mousemove', (e: MouseEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      isHovered = true;
    });
    window.addEventListener('mouseleave', () => { isHovered = false; });

    const animate = () => {
      orbStates.forEach((state) => {
        const dxCenter = state.cx - state.x;
        const dyCenter = state.cy - state.y;
        state.vx += dxCenter * 0.0005; 
        state.vy += dyCenter * 0.0005;
        
        if (isHovered) {
          const dxMouse = state.x - mouseX;
          const dyMouse = state.y - mouseY;
          const distMouse = Math.sqrt(dxMouse * dxMouse + dyMouse * dyMouse);
          const mouseRadius = 600;
          if (distMouse < mouseRadius && distMouse > 0) {
            const force = Math.pow((mouseRadius - distMouse) / mouseRadius, 2);
            state.vx += (dxMouse / distMouse) * force * 1.5;
            state.vy += (dyMouse / distMouse) * force * 1.5;
          }
        }

        state.vx += (Math.random() - 0.5) * 0.15;
        state.vy += (Math.random() - 0.5) * 0.15;

        state.vx *= 0.98;
        state.vy *= 0.98;
        
        const speed = Math.sqrt(state.vx * state.vx + state.vy * state.vy);
        const maxSpeed = 3.5;
        if (speed > maxSpeed) {
          state.vx = (state.vx / speed) * maxSpeed;
          state.vy = (state.vy / speed) * maxSpeed;
        }

        state.x += state.vx;
        state.y += state.vy;
      });

      // Collision detection between orbs
      for (let i = 0; i < orbStates.length; i++) {
        for (let j = i + 1; j < orbStates.length; j++) {
          const a = orbStates[i];
          const b = orbStates[j];
          const dx = b.x - a.x;
          const dy = b.y - a.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const minD = a.radius + b.radius;

          if (dist < minD && dist > 0) {
            const overlap = minD - dist;
            const nx = dx / dist;
            const ny = dy / dist;

            const separationX = nx * (overlap / 2);
            const separationY = ny * (overlap / 2);
            
            a.x -= separationX;
            a.y -= separationY;
            b.x += separationX;
            b.y += separationY;

            const rvx = b.vx - a.vx;
            const rvy = b.vy - a.vy;
            const velAlongNormal = rvx * nx + rvy * ny;
            
            if (velAlongNormal < 0) {
              const restitution = 0.5;
              const impulse = -(1 + restitution) * velAlongNormal;
              const impulseX = nx * impulse * 0.5;
              const impulseY = ny * impulse * 0.5;

              a.vx -= impulseX;
              a.vy -= impulseY;
              b.vx += impulseX;
              b.vy += impulseY;
            }
          }
        }
      }

      // Render
      orbStates.forEach((state) => {
        const tx = state.x - state.cx;
        const ty = state.y - state.cy;
        state.element.style.transform = `translate3d(${tx.toFixed(2)}px, ${ty.toFixed(2)}px, 0)`;
      });

      requestAnimationFrame(animate);
    };

    setTimeout(updateDimensions, 100);
    requestAnimationFrame(animate);
  }
</script>
